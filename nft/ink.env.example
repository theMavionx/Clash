MARKETPLACE_INK_CONTRACT=0x8290ab5e90db8bbf46c900b536bb5fdd7500d5e2

# Revenue recipients. Use a wallet controlled by ops; must be an EVM address.
GAME_SHOP_INK_TREASURY=0x...
MARKETPLACE_INK_USDC_TREASURY=0x...
NFT_INK_ROYALTY_RECEIVER=0x...

# Demon King NFT sale/upgrade config.
