INK_RPC_URL=https://rpc-gel.inkonchain.com
GAME_SHOP_INK_RPC_URL=https://rpc-gel.inkonchain.com

# Circle USDC on Ink mainnet.
NFT_INK_USDC_TOKEN=0x2D270e6886d130D724215A266106e6832161EAEd
GAME_SHOP_INK_USDC_TOKEN=0x2D270e6886d130D724215A266106e6832161EAEd
