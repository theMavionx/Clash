# Godot 4+ specific ignores
.godot/
/android/

# All node_modules everywhere
node_modules/

# Server
server/*.db
server/*.db.backup-*
server/*.db-wal
server/*.db-shm

# Futures Server
server-futures/*.db
server-futures/*.db-wal
server-futures/*.db-shm
server-futures/server.log
server-futures/gmtrade-builder/target/

# Local runtime logs
*.log
.local-logs/
server/reports/

# Local Codex request logs; private owner memory, not for GitHub
production/user-request-log.md
production/user-request-log*.md

# Environment
.env
.env.*
secrets/
*.orig
.asset-backups/

# Private migration portal lives in a separate repository.
relaunch/
deploy/migration/
clash-migration-portal.zip
lv_*.mp4
tmp/
nft/artifacts/COPRELAUNCH.json
nft/contracts/COPRELAUNCH.sol
nft/deployments/cop-relaunch-base-mainnet.json
nft/scripts/*cop-relaunch*.mjs
nft/scripts/kyberswap-cop-relaunch.mjs
nft/-

# Godot imports generated for web-only share images
web/public/win.jpg.import
web/public/lose.jpg.import
8a23c78d-3b91-4342-922e-e474f4a136a1.jpg.import
image copy.png.import
image.png.import
server/public/nft/voidspore/L1.png.import
server/public/nft/voidspore/L2.png.import
server/public/nft/voidspore/L3.jpg.import

# MCP
.mcp.json
addons/godot_mcp/

# Codex local workspace artifacts (agent configs, generated skills, logs)
.agents/
.codex/*
!.codex/docs/
!.codex/docs/**
!.codex/rules/
!.codex/rules/**
.clash-hermes-local/
.client-logs*.json

# Godot Web Export
web/public/godot/

# Decibel test wallet - contains private key, never commit
aptos-test-wallet.txt
backups/
.tmp/

# Aptos CLI binary downloaded locally for Move publishing (~130MB)
tools/aptos-cli/

# Hardhat caches/artifacts (Hardhat is used only for V3 fork tests;
# production deploys use the legacy solc compile script in nft/scripts/).
nft/artifacts-hh/
nft/cache-hh/
nft/.hh-cache/

# Move build outputs + per-project aptos profiles (contain devnet privkeys)
nft/move/**/build/
nft/move/**/.aptos/

# Production runtime folders when /opt/clash is used as the canonical checkout.
# They are created by deploy/deploy.sh and must not be copied back into git.
/current
/releases/
/shared/

# Android signing keystore + the password file living next to it.
# CRITICAL: leaking either == anyone can sign updates impersonating us
# on the Solana dApp Store. Both must live ONLY in our password
# manager + offline backup, NEVER in version control.
android-keystore/
twa/

# One-shot dev scripts (SSH probes, bubblewrap drivers). They contain
# hard-coded paths to local sensitive files (keystore path, prod SSH
# creds piped via env) — keep them out of the repo to make leaks
# harder when someone diffs commits.
.tmp-*
